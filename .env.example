# Copy to .env or export in shell. All values are SANDBOX placeholders.
PORT=3000

# PayPal Sandbox REST app credentials.
# Replace BOTH values with your own Sandbox app from https://developer.paypal.com/dashboard/applications/sandbox
# Until replaced, the server runs in DEMO MODE: checkout is simulated locally and no PayPal API is called.
PAYPAL_CLIENT_ID=REPLACE_ME_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_ME_SANDBOX_CLIENT_SECRET
PAYPAL_ENV=sandbox
# PAYPAL_ENV=live would point to https://api-m.paypal.com (never use live creds for the hackathon demo)

# Optional: an LLM API key for smarter NL parsing / summaries.
# Without it, a built-in rule-based parser and template generator are used (fully offline).
LLM_API_KEY=
